# ============================================================
#  Referencia das variaveis. NAO preencha aqui.
#  Configure os valores em: Railway -> servico -> Variables.
#  (local: crie um arquivo .env com estes nomes — ele fica fora do Git)
#
#  ESTE APP FUNCIONA EM QUALQUER DOMINIO. Nada de dominio fica
#  fixo no codigo — tudo abaixo e configuravel.
# ============================================================

# Chave SECRETA da PinPay. Comeca com  s k _ l i v e _
# Painel PinPay -> Configuracoes -> Chaves de API.
PINPAY_SECRET_KEY=

# Signing Secret do webhook. Comeca com  w h s e c _
# Painel PinPay -> Webhooks -> seu endpoint -> Signing Secret.
PINPAY_WEBHOOK_SECRET=

# URL publica DESTE app + /api/webhooks/pinpay
# (troque livremente se mudar de dominio)
# ex: https://checkout.SEU-DOMINIO.com/api/webhooks/pinpay
PINPAY_WEBHOOK_URL=

# Postgres. No Railway, valor = referencia do banco (nome do servico
# + .DATABASE_URL entre chaves duplas cifrao). Local: postgresql://...
DATABASE_URL=

# Para onde mandar o cliente depois de pagar (sua pagina de obrigado).
# Vazio = fica na propria tela de "pagamento confirmado".
SUCCESS_REDIRECT_URL=

# Dominio da sua loja. Usado so no redirect de GET /.
# Vazio = GET / responde um texto simples, sem redirecionar pra lugar nenhum.
STORE_ORIGIN=

# PORT: o Railway injeta sozinho. Local usa 3000.
