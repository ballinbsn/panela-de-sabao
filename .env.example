# ============================================================
#  Referencia das variaveis. NAO preencha aqui.
#  Configure os valores em: Railway -> servico -> Variables.
#  (local: crie um arquivo .env com estes nomes — ele fica fora do Git)
# ============================================================

# Chave SECRETA da PinPay. Comeca com  s k _ l i v e _
# Painel PinPay -> Configuracoes -> Chaves de API.
PINPAY_SECRET_KEY=

# Signing Secret do webhook. Comeca com  w h s e c _
# Painel PinPay -> Webhooks -> seu endpoint -> Signing Secret.
PINPAY_WEBHOOK_SECRET=

# URL publica deste app + /api/webhooks/pinpay
# ex: https://panela-de-sabao-production.up.railway.app/api/webhooks/pinpay
PINPAY_WEBHOOK_URL=

# Postgres. No Railway, valor = a referencia do banco (nome do servico + .DATABASE_URL
# entre chaves duplas cifrao). Local: sua string postgresql://...
DATABASE_URL=

# Para onde mandar o cliente depois de pagar.
SUCCESS_REDIRECT_URL=https://naturalli.shop

# Dominio da sua loja (cabecalho informativo).
STORE_ORIGIN=https://naturalli.shop

# PORT: o Railway injeta sozinho. Local usa 3000.
